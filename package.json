{
  "name": "@listeningkit/treg",
  "version": "0.1.3",
  "description": "Production Convex component for treg.to — the OpenRouter for developer tools. Run, route, and pay for 2,600+ tools through one API and CLI.",
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "files": [
    "dist",
    "convex.config.ts",
    "schema.ts",
    "treg.ts",
    "client.ts",
    "test.ts",
    "lib",
    "banner.png",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./convex.config": {
      "types": "./dist/convex.config.d.ts",
      "default": "./dist/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/convex.config.d.ts",
      "default": "./dist/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/_generated/component.d.ts"
    },
    "./_generated/component": {
      "types": "./dist/_generated/component.d.ts"
    },
    "./test": "./test.ts"
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.build.json --force",
    "build:clean": "rm -rf dist && npm run build",
    "build:codegen": "convex codegen --component-dir ./",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "convex": ">=1.45.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "convex": "^1.46.0",
    "convex-test": "^0.0.60",
    "typescript": "^5.6.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "convex",
    "convex-component",
    "treg",
    "tools",
    "openrouter-for-tools",
    "api-proxy",
    "developer-tools"
  ],
  "homepage": "https://treg.to/?ref=matthewdonse-aebsh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewdonsemail-lab/convex-treg.git"
  },
  "license": "Apache-2.0"
}
